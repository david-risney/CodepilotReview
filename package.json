{
  "name": "codepilot-review",
  "displayName": "CodepilotReview",
  "description": "VSCode extension for using Copilot to help with manual code review",
  "version": "0.2.0",
  "publisher": "codepilot-review",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codepilotReview.openReview",
        "title": "Open Review",
        "category": "CodepilotReview"
      },
      {
        "command": "codepilotReview.refreshPRs",
        "title": "Refresh Pull Requests",
        "category": "CodepilotReview",
        "icon": "$(refresh)"
      },
      {
        "command": "codepilotReview.filterPRs",
        "title": "Filter Pull Requests",
        "category": "CodepilotReview",
        "icon": "$(filter)"
      },
      {
        "command": "codepilotReview.runReviewTools",
        "title": "Run Review Tools",
        "category": "CodepilotReview",
        "icon": "$(play)"
      },
      {
        "command": "codepilotReview.publishDraftComments",
        "title": "Publish Draft Comments",
        "category": "CodepilotReview",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "codepilotReview.selectProvider",
        "title": "Manage Providers",
        "category": "CodepilotReview",
        "icon": "$(server-process)"
      },
      {
        "command": "codepilotReview.addView",
        "title": "Add View",
        "category": "CodepilotReview",
        "icon": "$(add)"
      },
      {
        "command": "codepilotReview.editProvider",
        "title": "Edit Provider",
        "category": "CodepilotReview",
        "icon": "$(edit)"
      },
      {
        "command": "codepilotReview.removeProviderNode",
        "title": "Remove Provider",
        "category": "CodepilotReview",
        "icon": "$(trash)"
      },
      {
        "command": "codepilotReview.editView",
        "title": "Edit View",
        "category": "CodepilotReview",
        "icon": "$(edit)"
      },
      {
        "command": "codepilotReview.removeView",
        "title": "Remove View",
        "category": "CodepilotReview",
        "icon": "$(trash)"
      },
      {
        "command": "codepilotReview.acceptIssue",
        "title": "Accept as Draft",
        "category": "CodepilotReview",
        "icon": "$(check)"
      },
      {
        "command": "codepilotReview.dismissIssue",
        "title": "Dismiss Issue",
        "category": "CodepilotReview",
        "icon": "$(close)"
      },
      {
        "command": "codepilotReview.challengeIssue",
        "title": "Really? (Challenge Issue)",
        "category": "CodepilotReview",
        "icon": "$(question)"
      },
      {
        "command": "codepilotReview.fixIssue",
        "title": "Fix Issue",
        "category": "CodepilotReview",
        "icon": "$(wrench)"
      },
      {
        "command": "codepilotReview.goToIssue",
        "title": "Go to Issue Location",
        "category": "CodepilotReview"
      },
      {
        "command": "codepilotReview.selectPartitionScheme",
        "title": "Select Partition Scheme",
        "category": "CodepilotReview",
        "icon": "$(list-selection)"
      },
      {
        "command": "codepilotReview.partitionByDependency",
        "title": "Partition by Dependency",
        "category": "CodepilotReview"
      },
      {
        "command": "codepilotReview.partitionByOwnership",
        "title": "Partition by Ownership",
        "category": "CodepilotReview"
      },
      {
        "command": "codepilotReview.partitionCustom",
        "title": "Add Custom Partition...",
        "category": "CodepilotReview",
        "icon": "$(add)"
      },
      {
        "command": "codepilotReview.removePartitionScheme",
        "title": "Remove Partition Scheme",
        "category": "CodepilotReview",
        "icon": "$(trash)"
      },
      {
        "command": "codepilotReview.regeneratePartitions",
        "title": "Regenerate Partitions",
        "category": "CodepilotReview",
        "icon": "$(refresh)"
      },
      {
        "command": "codepilotReview.startTour",
        "title": "Start Code Tour",
        "category": "CodepilotReview",
        "icon": "$(play)"
      },
      {
        "command": "codepilotReview.nextTourStep",
        "title": "Next Tour Step",
        "category": "CodepilotReview",
        "icon": "$(arrow-right)"
      },
      {
        "command": "codepilotReview.prevTourStep",
        "title": "Previous Tour Step",
        "category": "CodepilotReview",
        "icon": "$(arrow-left)"
      },
      {
        "command": "codepilotReview.stopTour",
        "title": "Stop Code Tour",
        "category": "CodepilotReview",
        "icon": "$(debug-stop)"
      },
      {
        "command": "codepilotReview.goToTourStep",
        "title": "Go to Tour Step",
        "category": "CodepilotReview"
      },
      {
        "command": "codepilotReview.showTourDetails",
        "title": "Show Tour Details",
        "category": "CodepilotReview",
        "icon": "$(book)"
      },
      {
        "command": "codepilotReview.suggestReviewers",
        "title": "Suggest Reviewers",
        "category": "CodepilotReview"
      },
      {
        "command": "codepilotReview.openChat",
        "title": "Chat About Change",
        "category": "CodepilotReview",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "codepilotReview.signIn",
        "title": "Sign In",
        "category": "CodepilotReview"
      },
      {
        "command": "codepilotReview.signOut",
        "title": "Sign Out",
        "category": "CodepilotReview"
      },
      {
        "command": "codepilotReview.openConfig",
        "title": "Open Configuration",
        "category": "CodepilotReview",
        "icon": "$(gear)"
      },
      {
        "command": "codepilotReview.openSettings",
        "title": "Open Settings",
        "category": "CodepilotReview",
        "icon": "$(gear)"
      },
      {
        "command": "codepilotReview.viewDiff",
        "title": "View File Diff",
        "category": "CodepilotReview",
        "icon": "$(diff)"
      },
      {
        "command": "codepilotReview.openFileDiff",
        "title": "Open File as Diff",
        "category": "CodepilotReview",
        "icon": "$(diff)"
      },
      {
        "command": "codepilotReview.generateParsePattern",
        "title": "Generate Parse Pattern from Example Output",
        "category": "CodepilotReview"
      },
      {
        "command": "codepilotReview.createIssue",
        "title": "Create Review Issue",
        "category": "CodepilotReview",
        "icon": "$(add)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codepilotReview",
          "title": "CodepilotReview",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "codepilotReview": [
        {
          "id": "codepilotReview.prList",
          "name": "Pull Requests"
        },
        {
          "id": "codepilotReview.reviewIssues",
          "name": "Review Issues",
          "when": "codepilotReview.hasActiveReview && !codepilotReview.hasActiveTour"
        },
        {
          "id": "codepilotReview.partitions",
          "name": "Partitions",
          "when": "codepilotReview.hasActiveReview && !codepilotReview.hasActiveTour"
        },
        {
          "id": "codepilotReview.tourDetails",
          "type": "webview",
          "name": "Code Tour",
          "when": "codepilotReview.hasActiveTour"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codepilotReview.prList",
        "contents": "No code review providers configured.\n[Add Provider](command:codepilotReview.selectProvider)\nConfigure providers to see pull requests here.",
        "when": "codepilotReview.noProviders"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codepilotReview.selectProvider",
          "when": "view == codepilotReview.prList",
          "group": "navigation"
        },
        {
          "command": "codepilotReview.refreshPRs",
          "when": "view == codepilotReview.prList",
          "group": "navigation"
        },
        {
          "command": "codepilotReview.filterPRs",
          "when": "view == codepilotReview.prList",
          "group": "navigation"
        },
        {
          "command": "codepilotReview.openSettings",
          "when": "view == codepilotReview.prList",
          "group": "navigation"
        },
        {
          "command": "codepilotReview.runReviewTools",
          "when": "view == codepilotReview.reviewIssues",
          "group": "navigation"
        },
        {
          "command": "codepilotReview.createIssue",
          "when": "view == codepilotReview.reviewIssues",
          "group": "navigation"
        },
        {
          "command": "codepilotReview.publishDraftComments",
          "when": "view == codepilotReview.reviewIssues",
          "group": "navigation"
        },
        {
          "command": "codepilotReview.selectPartitionScheme",
          "when": "view == codepilotReview.partitions",
          "group": "navigation"
        },
        {
          "command": "codepilotReview.partitionCustom",
          "when": "view == codepilotReview.partitions",
          "group": "navigation"
        },
        {
          "command": "codepilotReview.startTour",
          "when": "view == codepilotReview.partitions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "codepilotReview.acceptIssue",
          "when": "viewItem =~ /reviewIssue:suggested/",
          "group": "inline"
        },
        {
          "command": "codepilotReview.dismissIssue",
          "when": "viewItem =~ /reviewIssue:(suggested|draft)/",
          "group": "inline"
        },
        {
          "command": "codepilotReview.challengeIssue",
          "when": "viewItem =~ /reviewIssue:(suggested|draft)/",
          "group": "1_actions"
        },
        {
          "command": "codepilotReview.fixIssue",
          "when": "viewItem =~ /reviewIssue:(suggested|draft)/",
          "group": "1_actions"
        },
        {
          "command": "codepilotReview.addView",
          "when": "viewItem == provider",
          "group": "inline"
        },
        {
          "command": "codepilotReview.editProvider",
          "when": "viewItem == provider",
          "group": "1_provider"
        },
        {
          "command": "codepilotReview.removeProviderNode",
          "when": "viewItem == provider",
          "group": "1_provider"
        },
        {
          "command": "codepilotReview.editView",
          "when": "viewItem == providerView",
          "group": "inline"
        },
        {
          "command": "codepilotReview.removeView",
          "when": "viewItem == providerView",
          "group": "inline"
        },
        {
          "command": "codepilotReview.regeneratePartitions",
          "when": "viewItem == partitionScheme || viewItem == partitionSchemeCustom",
          "group": "inline"
        },
        {
          "command": "codepilotReview.removePartitionScheme",
          "when": "viewItem == partitionSchemeCustom",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "CodepilotReview",
      "properties": {
        "codepilotReview.providers": {
          "type": "array",
          "default": [],
          "description": "Code review provider instances. Each entry configures one provider with its connection settings and optional views.",
          "markdownDescription": "Code review provider instances. Each entry configures one provider with its connection settings and optional views (saved searches).\n\nExample:\n```json\n[\n  {\n    \"id\": \"ado-edge\",\n    \"label\": \"Edge PRs\",\n    \"type\": \"azureDevOps\",\n    \"organization\": \"microsoft\",\n    \"project\": \"Edge\",\n    \"views\": [\n      { \"id\": \"my-prs\", \"label\": \"My PRs\", \"query\": { \"type\": \"azureDevOps\", \"creatorId\": \"me\" } },\n      { \"id\": \"needs-review\", \"label\": \"Needs Review\", \"query\": { \"type\": \"azureDevOps\", \"reviewerId\": \"me\" } }\n    ]\n  },\n  {\n    \"id\": \"github-vscode\",\n    \"label\": \"VS Code GitHub\",\n    \"type\": \"github\",\n    \"owner\": \"microsoft\",\n    \"repo\": \"vscode\"\n  }\n]\n```",
          "items": {
            "type": "object",
            "required": ["id", "label", "type"],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier for this provider instance (e.g. 'ado-edge', 'github-vscode')"
              },
              "label": {
                "type": "string",
                "description": "Display label shown in the PR list (e.g. 'Edge PRs', 'VS Code GitHub')"
              },
              "type": {
                "type": "string",
                "enum": ["local", "azureDevOps", "github", "chromium"],
                "description": "Provider type"
              },
              "organization": {
                "type": "string",
                "description": "(ADO) Azure DevOps organization name (e.g. 'microsoft')"
              },
              "project": {
                "type": "string",
                "description": "(ADO) Azure DevOps project name (e.g. 'Edge')"
              },
              "repositoryId": {
                "type": "string",
                "description": "(ADO) Azure DevOps repository ID or name (e.g. 'WebView2')"
              },
              "owner": {
                "type": "string",
                "description": "(GitHub) Repository owner (e.g. 'microsoft')"
              },
              "repo": {
                "type": "string",
                "description": "(GitHub) Repository name (e.g. 'vscode')"
              },
              "host": {
                "type": "string",
                "description": "(Chromium) Gerrit host URL (e.g. 'https://chromium-review.googlesource.com')"
              },
              "baseBranch": {
                "type": "string",
                "description": "(Local) Base branch for diff comparison (e.g. 'main')"
              },
              "views": {
                "type": "array",
                "description": "Saved search views for this provider. If empty, a default 'All' view is created.",
                "items": {
                  "type": "object",
                  "required": ["id", "label"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique view identifier within this provider (e.g. 'my-prs', 'team-reviews')"
                    },
                    "label": {
                      "type": "string",
                      "description": "Display label for this view (e.g. 'My PRs', 'Needs Review')"
                    },
                    "query": {
                      "type": "object",
                      "description": "Provider-specific search criteria. Shape varies by provider type.",
                      "properties": {
                        "type": { "type": "string", "enum": ["azureDevOps", "github", "chromium", "local"] },
                        "status": { "type": "string", "description": "(ADO/Chromium) Status filter" },
                        "creatorId": { "type": "string", "description": "(ADO) Creator user ID or name" },
                        "reviewerId": { "type": "string", "description": "(ADO) Reviewer user ID or name" },
                        "repositoryId": { "type": "string", "description": "(ADO) Repository ID to scope" },
                        "searchQuery": { "type": "string", "description": "(GitHub) Search query string" },
                        "state": { "type": "string", "description": "(GitHub) PR state: open, closed, all" },
                        "author": { "type": "string", "description": "(GitHub) Author filter" },
                        "owner": { "type": "string", "description": "(Chromium) Owner filter" }
                      }
                    },
                    "filter": {
                      "type": "object",
                      "description": "Client-side filters applied after fetching.",
                      "properties": {
                        "text": { "type": "string", "description": "Text search across title, author, description" },
                        "statuses": { "type": "array", "items": { "type": "string" }, "description": "Filter by PR status" },
                        "userNeed": { "type": "array", "items": { "type": "string" }, "description": "Filter by user need level" },
                        "priority": { "type": "array", "items": { "type": "string" }, "description": "Filter by priority" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "codepilotReview.diffMode": {
          "type": "object",
          "default": {},
          "description": "Controls how diff views are displayed. Configure which content appears on each side.",
          "markdownDescription": "Controls which content appears on the left and right sides of diff views.\n\nSide options:\n- `remote-before`: File content before the code review change (from the provider)\n- `remote-after`: File content after the code review change (from the provider)\n- `local-current`: The file as it exists on disk right now (including uncommitted changes)\n- `local-branch-base`: The file at the point where the current branch diverged from the base branch\n\nDefaults:\n- Remote providers (GitHub, ADO, Chromium): left=`remote-before`, right=`remote-after`\n- Local provider: left=`local-branch-base`, right=`local-current`\n\nExample — compare remote PR changes against your local working copy:\n```json\n{\n  \"left\": \"remote-before\",\n  \"right\": \"local-current\"\n}\n```",
          "properties": {
            "left": {
              "type": "string",
              "enum": ["remote-before", "remote-after", "local-current", "local-branch-base"],
              "description": "Content source for the left (old) side of the diff"
            },
            "right": {
              "type": "string",
              "enum": ["remote-before", "remote-after", "local-current", "local-branch-base"],
              "description": "Content source for the right (new) side of the diff"
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "test:unit": "npm run compile && mocha --require ./src/test/unit/setup.js --ui tdd --timeout 10000 \"out/test/suite/**/*.test.js\"",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.120.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.56.0",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
